<% layout("/layouts/boilerplate") %>
<div class="container py-5"><div class="mb-4"><h2><i class="fa-solid fa-shield-halved"></i> Admin control centre</h2><p class="text-muted mb-0">Platform health, transaction oversight, and owner payouts.</p></div>
<div class="row g-3 mb-4"><% [["Gross revenue",stats.revenue,"success"],["Platform profit",stats.profit,"primary"],["Owner payouts",stats.ownerPayouts,"dark"],["Paid transactions",stats.paidCount,"info"]].forEach(card=>{ %><div class="col-6 col-lg-3"><div class="card border-0 bg-<%= card[2] %> text-white"><div class="card-body"><small><%= card[0] %></small><h3 class="mb-0"><%= typeof card[1] === 'number' && card[0] !== 'Paid transactions' ? '₹'+card[1].toLocaleString('en-IN') : card[1] %></h3></div></div></div><% }) %></div>
<div class="row g-3 mb-4"><div class="col-md-8"><div class="card h-100"><div class="card-body"><h5>Platform inventory</h5><div class="row text-center"><div class="col"><strong><%= stats.users %></strong><br><small>Users</small></div><div class="col"><strong><%= stats.rooms %></strong><br><small>Rooms</small></div><div class="col"><strong><%= stats.messes %></strong><br><small>Messes</small></div><div class="col"><strong><%= stats.laundries %></strong><br><small>Laundry</small></div><div class="col"><strong><%= stats.vehicles %></strong><br><small>Vehicles</small></div></div></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><h5>Action queue</h5><p class="mb-1"><strong><%= stats.pendingCod %></strong> COD confirmations pending</p><p class="mb-1"><strong><%= stats.pendingPayoutRequests %></strong> payout requests awaiting review</p><p class="mb-0"><strong><%= stats.pendingPayout %></strong> wallet credits available</p></div></div></div></div>
<div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><strong>Owner payout requests</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Owner</th><th>Amount</th><th>Destination</th><th>Status</th><th>Action</th></tr></thead><tbody><% if(!payoutRequests.length){ %><tr><td colspan="5" class="text-center py-4 text-muted">No payout requests yet.</td></tr><% } %><% payoutRequests.forEach(request => { %><tr><td><%= request.owner?.username || '-' %></td><td>₹<%= request.amount.toLocaleString('en-IN') %></td><td><%= request.payoutDetails.method === 'upi' ? request.payoutDetails.upiId : request.payoutDetails.bankName + ' · ' + request.payoutDetails.accountNumber.slice(-4) %></td><td><span class="badge bg-<%= request.status === 'paid' ? 'success' : request.status === 'rejected' ? 'danger' : 'warning text-dark' %>"><%= request.status %></span></td><td><% if(request.status === 'pending'){ %><form action="/admin/payout-requests/<%= request._id %>" method="POST" class="d-flex gap-1"><input type="hidden" name="status" value="paid"><button class="btn btn-sm btn-success">Mark paid</button></form><form action="/admin/payout-requests/<%= request._id %>" method="POST" class="mt-1"><input type="hidden" name="status" value="rejected"><button class="btn btn-sm btn-outline-danger">Reject</button></form><% } %></td></tr><% }) %></tbody></table></div></div>
<div class="card shadow-sm border-0"><div class="card-header bg-white"><strong>Latest payments</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Student</th><th>Owner</th><th>Amount</th><th>Method</th><th>Status</th><th>Wallet</th><th></th></tr></thead><tbody><% if(!recentPayments.length){ %><tr><td colspan="7" class="text-center py-5 text-muted">No payment records yet.</td></tr><% } %><% recentPayments.forEach(payment=>{ %><tr><td><%= payment.student?.username || '-' %></td><td><%= payment.owner?.username || '-' %></td><td>₹<%= payment.amount.toLocaleString('en-IN') %></td><td><%= payment.method.toUpperCase() %></td><td><span class="badge bg-<%= payment.status === 'paid' ? 'success' : 'warning text-dark' %>"><%= payment.status %></span></td><td><%= payment.walletStatus %></td><td><% if(payment.status === 'paid' && payment.walletStatus === 'available'){ %><form action="/admin/payments/<%= payment._id %>/settle" method="POST"><button class="btn btn-sm btn-outline-primary">Mark paid out</button></form><% } %></td></tr><% }) %></tbody></table></div></div></div>
