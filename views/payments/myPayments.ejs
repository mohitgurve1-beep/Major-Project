<% layout("/layouts/boilerplate") %>
<div class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>My payments</h2><p class="text-muted mb-0">Track your booking and payment status</p></div><a href="/listings" class="btn btn-outline-primary">Browse rooms</a></div>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Room</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th></tr></thead><tbody>
<% if(!payments.length){ %><tr><td colspan="5" class="text-center py-5 text-muted">No payments yet.</td></tr><% } %>
<% payments.forEach(payment => { %><tr><td><strong><%= payment.service?.title || payment.service?.name || payment.listing?.title || 'Service removed' %></strong><br><small class="text-muted"><%= payment.serviceType %></small></td><td>₹<%= payment.amount.toLocaleString('en-IN') %><% if(payment.remainingAmount > 0) { %><br><small class="text-danger">Remaining pending: ₹<%= payment.remainingAmount.toLocaleString('en-IN') %></small><% } %><% if(payment.status === 'partially_paid' && payment.remainingAmount > 0) { %><br><a href="/payments/<%= payment._id %>/remaining" class="btn btn-sm btn-outline-primary mt-2">Pay remaining</a><% } %></td><td><%= payment.method === 'cod' ? 'COD' : 'Online' %></td><td><span class="badge bg-<%= ['paid','partially_paid'].includes(payment.status) ? 'success' : payment.status === 'failed' ? 'danger' : 'warning text-dark' %>"><%= payment.status === 'pending_cod' ? 'Awaiting COD confirmation' : payment.status === 'partially_paid' ? 'Advance paid' : payment.status %></span></td><td><%= payment.createdAt.toLocaleDateString('en-IN') %></td></tr><% }) %>
</tbody></table></div></div></div>
