<% layout("/layouts/boilerplate") %>
<div class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>Owner wallet</h2><p class="text-muted mb-0">Confirm COD collections and monitor your earnings.</p></div><a href="/listings/owner/dashboard" class="btn btn-outline-primary">Owner dashboard</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 bg-success text-white"><div class="card-body"><small>Available balance</small><h3 class="mb-0">₹<%= (wallet.available || 0).toLocaleString('en-IN') %></h3></div></div></div><div class="col-md-4"><div class="card border-0 bg-dark text-white"><div class="card-body"><small>Lifetime earnings</small><h3 class="mb-0">₹<%= (wallet.lifetimeEarnings || 0).toLocaleString('en-IN') %></h3></div></div></div><div class="col-md-4"><div class="card border-0 bg-light"><div class="card-body"><small>Paid out</small><h3 class="mb-0">₹<%= (wallet.withdrawn || 0).toLocaleString('en-IN') %></h3></div></div></div></div>
<div class="row g-3 mb-4"><div class="col-lg-7"><div class="card h-100"><div class="card-body"><h5>Request a payout</h5><p class="small text-muted">Available: ₹<%= (wallet.available || 0).toLocaleString('en-IN') %> · Pending: ₹<%= (wallet.pendingPayout || 0).toLocaleString('en-IN') %></p><form action="/payments/owner/payout-request" method="POST" class="d-flex gap-2"><input type="number" min="1" max="<%= wallet.available || 0 %>" name="amount" class="form-control" placeholder="Amount" required><button class="btn btn-primary">Request payout</button></form></div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h5>Where should we pay?</h5><form action="/payments/owner/payout-details" method="POST"><select name="payoutDetails[method]" class="form-select mb-2"><option value="upi" <%= payoutDetails.method === 'upi' ? 'selected' : '' %>>UPI</option><option value="bank" <%= payoutDetails.method === 'bank' ? 'selected' : '' %>>Bank account</option></select><input class="form-control mb-2" name="payoutDetails[upiId]" value="<%= payoutDetails.upiId || '' %>" placeholder="UPI ID (e.g. name@bank)"><input class="form-control mb-2" name="payoutDetails[accountHolder]" value="<%= payoutDetails.accountHolder || '' %>" placeholder="Account holder name"><input class="form-control mb-2" name="payoutDetails[bankName]" value="<%= payoutDetails.bankName || '' %>" placeholder="Bank name"><input class="form-control mb-2" name="payoutDetails[accountNumber]" value="<%= payoutDetails.accountNumber || '' %>" placeholder="Account number"><input class="form-control mb-2" name="payoutDetails[ifsc]" value="<%= payoutDetails.ifsc || '' %>" placeholder="IFSC code"><button class="btn btn-outline-primary btn-sm">Save payout details</button></form></div></div></div></div>
<% if(payoutRequests.length) { %><div class="card mb-4"><div class="card-body"><h5>Your payout requests</h5><% payoutRequests.forEach(request => { %><div class="d-flex justify-content-between border-top pt-2 mt-2"><span>₹<%= request.amount.toLocaleString('en-IN') %> · <%= request.payoutDetails.method.toUpperCase() %></span><span class="badge bg-<%= request.status === 'paid' ? 'success' : request.status === 'rejected' ? 'danger' : 'warning text-dark' %>"><%= request.status %></span></div><% }) %></div></div><% } %>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Student / Service</th><th>Collected</th><th>Wallet credit</th><th>Method</th><th>Status</th><th></th></tr></thead><tbody><% if(!payments.length){ %><tr><td colspan="6" class="text-center py-5 text-muted">No payment activity yet.</td></tr><% } %><% payments.forEach(payment => { %><tr><td><strong><%= payment.student?.username || 'Student' %></strong><br><small class="text-muted"><%= payment.service?.title || payment.service?.name || payment.listing?.title || 'Service removed' %></small></td><td>₹<%= payment.amount.toLocaleString('en-IN') %><% if(payment.remainingAmount > 0) { %><br><small class="text-danger">Remaining: ₹<%= payment.remainingAmount.toLocaleString('en-IN') %></small><% } %></td><td><%= payment.method === 'cod' ? 'Cash collected directly' : '₹' + payment.ownerAmount.toLocaleString('en-IN') %></td><td><%= payment.method.toUpperCase() %></td><td><span class="badge bg-<%= ['paid','partially_paid'].includes(payment.status) ? 'success' : 'warning text-dark' %>"><%= payment.status === 'pending_cod' ? 'Awaiting cash' : payment.status === 'partially_paid' ? 'Advance paid; balance pending' : payment.method === 'cod' ? 'Cash received' : payment.walletStatus %></span></td><td><% if(payment.status === 'pending_cod'){ %><form action="/payments/<%= payment._id %>/confirm-cod" method="POST"><button class="btn btn-sm btn-success">Confirm cash received</button></form><% } %></td></tr><% }) %></tbody></table></div></div></div>
