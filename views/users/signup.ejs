<% layout("/layouts/boilerplate") %>

<div class="container">
<div class="row mt-3 justify-content-center">
    <h1 class="col-12 col-md-6">Sign Up — Student Accommodation</h1>
    <div class="col-12 col-md-6">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" name="username" id="username" class="form-control" required> 
            <div class="valid-feedback">Looks good!</div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" name="email" id="email" class="form-control" required> 
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" name="password" id="password" class="form-control" required> 
          </div>
          <div class="mb-3">
            <label for="role" class="form-label">I am a</label>
            <select name="role" id="role" class="form-control" required>
                <option value="student">Student / Working Professional</option>
                <option value="owner">Property Owner</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="phone" class="form-label">Phone Number (optional)</label>
            <input type="text" name="phone" id="phone" class="form-control" placeholder="+91 9876543210">
          </div>
          <div class="mb-3">
            <label for="whatsapp" class="form-label">WhatsApp Number (optional)</label>
            <input type="text" name="whatsapp" id="whatsapp" class="form-control" placeholder="+91 9876543210">
          </div>
<button class="btn btn-success">Sign Up</button>
        </form>
    </div>
</div>
</div>

