<% layout("/layouts/boilerplate") %>
<div class="container">
<div class="row mt-3 justify-content-center">
    <div class="col-12 col-md-8">
        <h3>Edit your listing</h3>
        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="listing[title]" value="<%= listing.title %>" class="form-control" required>
                <div class="valid-feedback">Title looks good!</div>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
                <div class="invalid-feedback">Please enter a short description</div>
            </div>

            <div class="mb-3" >
                Original Listing Image
                <br>
                <img src="<%= originalImageUrl %>" alt="" class="img-fluid mt-2" style="max-height: 200px; width: auto; border-radius: 8px;"> 
            </div>
            
            <div class="mb-3">
                <label for="image" class="form-label">Upload New Image</label>
                <input type="file" name="listing[image]"  class="form-control" >
            </div>
            
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" value="<%= listing.price %>" class="form-control" required>
                    <div class="invalid-feedback">Price should be valid</div>
                </div>
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" value="<%= listing.country %>" class="form-control" required>
                    <div class="invalid-feedback">Country should be valid</div>
                </div>
            </div>
            
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="listing[location]" value="<%= listing.location %>" class="form-control" required>
                <div class="invalid-feedback">Location should be valid</div>
            </div>

            <!-- Phase 11 — Advanced Search & Filter fields (additive, all optional) -->
            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="city" class="form-label">City</label>
                    <input type="text" name="listing[city]" placeholder="e.g. Nagpur" class="form-control" value="<%= listing.city || '' %>">
                    <small class="text-muted">Used for city-based search filtering.</small>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="roomType" class="form-label">Room Type</label>
                    <select name="listing[roomType]" id="roomType" class="form-select">
                        <option value="">Select Room Type</option>
                        <% for(let t of roomTypes) { %>
                            <option value="<%= t %>" <%= listing.roomType === t ? 'selected' : '' %>><%= t %></option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="furnishing" class="form-label">Furnishing</label>
                    <select name="listing[furnishing]" id="furnishing" class="form-select">
                        <option value="">Select Furnishing</option>
                        <% for(let o of furnishingOptions) { %>
                            <option value="<%= o %>" <%= listing.furnishing === o ? 'selected' : '' %>><%= o %></option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="genderPreference" class="form-label">Gender Preference</label>
                    <select name="listing[genderPreference]" id="genderPreference" class="form-select">
                        <option value="">Select Gender Preference</option>
                        <% for(let o of genderOptions) { %>
                            <option value="<%= o %>" <%= listing.genderPreference === o ? 'selected' : '' %>><%= o %></option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="availability" class="form-label">Availability</label>
                    <select name="listing[availability]" id="availability" class="form-select">
                        <option value="">Select Availability</option>
                        <% for(let o of availabilityOptions) { %>
                            <option value="<%= o %>" <%= listing.availability === o ? 'selected' : '' %>><%= o %></option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="minimumStay" class="form-label">Minimum Stay (months)</label>
                    <input type="number" name="listing[minimumStay]" id="minimumStay" min="1" max="36" placeholder="e.g. 6" class="form-control" value="<%= listing.minimumStay || '' %>">
                </div>
                <div class="mb-3 col-12">
                    <label class="form-label d-block">Amenities (select all that apply)</label>
                    <div class="row g-2">
                        <% for(let a of amenityOptions) { %>
                            <div class="col-md-6 col-sm-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="edit-amenity-<%= a.replace(/\s+/g, '-').replace(/\//g, '-') %>" <%= (listing.amenities && listing.amenities.includes(a)) ? 'checked' : '' %>>
                                    <label class="form-check-label" for="edit-amenity-<%= a.replace(/\s+/g, '-').replace(/\//g, '-') %>"><%= a %></label>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <!-- <br><br> -->
<button class="btn btn-dark edit-btn mt-3">Edit</button>
            <br><br>
        </form>
    </div>
   </div>
</div>
