<% layout("/layouts/boilerplate") %>

<style>
  .request-card {
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .request-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
  }
  .status-badge {
    font-size: 0.8rem;
    padding: 0.4em 0.7em;
    border-radius: 20px;
  }
</style>

<div class="container">

<div class="dashboard-header mt-4 mb-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h2><i class="fa-solid fa-calendar-check"></i> Visit Requests</h2>
      <p class="text-muted">Manage visit requests for your rooms</p>
    </div>
    <a href="/listings/owner/dashboard" class="btn btn-outline-dark">
      <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
    </a>
  </div>

<% if(allVisitRequests.length === 0) { %>
  <div class="text-center py-5">
    <i class="fa-solid fa-inbox fa-3x text-muted mb-3"></i>
    <h5 class="text-muted">No visit requests yet.</h5>
    <p class="text-muted">When students request to visit your rooms, they will appear here.</p>
  </div>
<% } else { %>
  <div class="row g-4">
    <% for(let request of allVisitRequests) { %>
      <div class="col-md-6">
        <div class="card request-card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div>
                <h5 class="card-title mb-1"><%= request.listingTitle %></h5>
                <p class="text-muted mb-0 small">
                  <i class="fa-solid fa-user"></i> <%= request.student ? request.student.username : 'Unknown' %>
                  <% if(request.student && request.student.email) { %>
                    &middot; <%= request.student.email %>
                  <% } %>
                </p>
              </div>
              <div>
                <% if(request.status === 'pending') { %>
                  <span class="badge bg-warning text-dark status-badge">Pending</span>
                <% } else if(request.status === 'accepted') { %>
                  <span class="badge bg-success status-badge">Accepted</span>
                <% } else if(request.status === 'rejected') { %>
                  <span class="badge bg-danger status-badge">Rejected</span>
                <% } else if(request.status === 'completed') { %>
                  <span class="badge bg-secondary status-badge">Completed</span>
                <% } %>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-6">
                <p class="mb-1 small text-muted"><i class="fa-regular fa-calendar"></i> Date</p>
                <p class="mb-0"><%= new Date(request.date).toLocaleDateString("en-IN", { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></p>
              </div>
            </div>
              <div class="col-6">
                <p class="mb-1 small text-muted"><i class="fa-regular fa-clock"></i> Time</p>
                <p class="mb-0"><%= request.time %></p>
              </div>

            <% if(request.message) { %>
              <div class="mb-3">
                <p class="mb-1 small text-muted"><i class="fa-regular fa-message"></i> Message</p>
                <p class="mb-0 bg-light p-2 rounded small"><%= request.message %></p>
              </div>
            <% } %>

            <% if(request.status === 'pending') { %>
              <div class="d-flex gap-2 mt-3">
                <form action="/listings/<%= request.listingId %>/visit-request/<%= request._id %>/status" method="POST" style="display:inline;">
                  <input type="hidden" name="status" value="accepted">
                  <button class="btn btn-success btn-sm"><i class="fa-solid fa-check"></i> Accept</button>
                </form>
                <form action="/listings/<%= request.listingId %>/visit-request/<%= request._id %>/status" method="POST" style="display:inline;">
                  <input type="hidden" name="status" value="rejected">
                  <button class="btn btn-danger btn-sm"><i class="fa-solid fa-times"></i> Reject</button>
                </form>
              </div>
            <% } else if(request.status === 'accepted') { %>
              <div class="mt-3">
                <form action="/listings/<%= request.listingId %>/visit-request/<%= request._id %>/status" method="POST" style="display:inline;">
                  <input type="hidden" name="status" value="completed">
                  <button class="btn btn-secondary btn-sm"><i class="fa-solid fa-check-double"></i> Mark Completed</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
</div>
