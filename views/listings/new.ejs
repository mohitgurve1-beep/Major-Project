<% layout("/layouts/boilerplate") %>
<div class="container">
<div class="row mt-3 justify-content-center">
    <div class="col-12 col-md-8">
    <h3>Create a new listing</h3>
    <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-control" required> 
          <div class="valid-feedback">Title looks good!</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
        </div>

        <div class="mb-3">
            <label for="images" class="form-label">Upload listing images (up to 10)</label>
            <input type="file" name="images" class="form-control" multiple accept="image/*" id="images">
            <small class="text-muted">You can select multiple images at once. Max 10 images, 8MB each.</small>
        </div>
        
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input name="listing[price]" placeholder="1200" class="form-control" required>
                <div class="invalid-feedback">Price should be valid</div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input type="text" name="listing[country]" placeholder="India" class="form-control" required>
                <div class="invalid-feedback">Country should be valid</div>
            </div>
        </div>
       
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" placeholder="Nagpur,Maharashtra" class="form-control" required>
            <div class="invalid-feedback">Location should be valid</div>
        </div>

        <!-- Phase 11 — Advanced Search & Filter fields (additive, all optional) -->
        <div class="row">
            <div class="mb-3 col-md-6">
                <label for="city" class="form-label">City</label>
                <input type="text" name="listing[city]" placeholder="e.g. Nagpur" class="form-control">
                <small class="text-muted">Used for city-based search filtering.</small>
            </div>
            <div class="mb-3 col-md-6">
                <label for="roomType" class="form-label">Room Type</label>
                <select name="listing[roomType]" id="roomType" class="form-select">
                    <option value="">Select Room Type</option>
                    <% for(let t of roomTypes) { %>
                        <option value="<%= t %>"><%= t %></option>
                    <% } %>
                </select>
            </div>
            <div class="mb-3 col-md-6">
                <label for="furnishing" class="form-label">Furnishing</label>
                <select name="listing[furnishing]" id="furnishing" class="form-select">
                    <option value="">Select Furnishing</option>
                    <% for(let o of furnishingOptions) { %>
                        <option value="<%= o %>"><%= o %></option>
                    <% } %>
                </select>
            </div>
            <div class="mb-3 col-md-6">
                <label for="genderPreference" class="form-label">Gender Preference</label>
                <select name="listing[genderPreference]" id="genderPreference" class="form-select">
                    <option value="">Select Gender Preference</option>
                    <% for(let o of genderOptions) { %>
                        <option value="<%= o %>"><%= o %></option>
                    <% } %>
                </select>
            </div>
            <div class="col-12 border rounded p-3 mb-3 bg-light"><strong>Booking payment policy</strong><div class="row mt-2"><div class="col-md-6"><select name="listing[bookingPayment]" class="form-select"><option value="full">Require full payment</option><option value="advance">Require minimum advance</option><option value="flexible">Let student choose advance or full payment</option><option value="none">No advance — booking request only</option></select></div><div class="col-md-6"><input type="number" min="0" name="listing[minimumAdvance]" class="form-control" placeholder="Minimum advance amount (₹)"></div></div></div>
            <div class="mb-3 col-md-6">
                <label for="availability" class="form-label">Availability</label>
                <select name="listing[availability]" id="availability" class="form-select">
                    <option value="">Select Availability</option>
                    <% for(let o of availabilityOptions) { %>
                        <option value="<%= o %>"><%= o %></option>
                    <% } %>
                </select>
            </div>
            <div class="mb-3 col-md-6">
                <label for="minimumStay" class="form-label">Minimum Stay (months)</label>
                <input type="number" name="listing[minimumStay]" id="minimumStay" min="1" max="36" placeholder="e.g. 6" class="form-control">
            </div>
            <div class="mb-3 col-12">
                <label class="form-label d-block">Amenities (select all that apply)</label>
                <div class="row g-2">
                    <% for(let a of amenityOptions) { %>
                        <div class="col-md-6 col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="listing[amenities]" value="<%= a %>" id="new-amenity-<%= a.replace(/\s+/g, '-').replace(/\//g, '-') %>">
                                <label class="form-check-label" for="new-amenity-<%= a.replace(/\s+/g, '-').replace(/\//g, '-') %>"><%= a %></label>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

<button class="btn btn-dark add-btn mt-3">Add</button>
        <br><br>
    </form>
</div>
</div>
</div>
