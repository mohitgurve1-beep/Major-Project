<% layout("/layouts/boilerplate") %>

<!-- ============================================ -->
<!-- PREMIUM HOMEPAGE (Component-Based)           -->
<!-- Each section is an independent partial.      -->
<!-- Add new modules by creating a partial and    -->
<!-- including it here — no other changes needed. -->
<!-- ============================================ -->

<%- include("../includes/home/hero.ejs") %>
<%- include("../includes/home/quickCategories.ejs") %>
<%- include("../includes/home/featuredRooms.ejs") %>
<%- include("../includes/home/nearColleges.ejs") %>
<%- include("../includes/home/mapPreview.ejs") %>
<%- include("../includes/home/recentRooms.ejs") %>
<%- include("../includes/home/topRatedOwners.ejs") %>
<%- include("../includes/home/services.ejs") %>
<%- include("../includes/home/vehicleServices.ejs") %>
<%- include("../includes/home/statistics.ejs") %>
<%- include("../includes/home/whyChooseUs.ejs") %>
<%- include("../includes/home/testimonials.ejs") %>
<%- include("../includes/home/ctaBanner.ejs") %>

<!-- ============================================ -->
<!-- ALL LISTINGS + ADVANCED SEARCH & FILTERS     -->
<!-- (Phase 11 — preserved, backward compatible)  -->
<!-- ============================================ -->
<div class="container mt-4 mb-5">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
      <h2 class="section-title mb-1">Explore Student Rooms</h2>
      <p class="text-muted mb-0">
        Showing <%= allListings.length %> room(s)
      </p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <form action="/listings" method="GET" class="d-flex align-items-center gap-2" id="filterSortForm">
        <% for(let key in filters) { %>
          <% if(key === 'sort' || key === 'amenities') continue; %>
          <% if(filters[key] !== '' && filters[key] !== null && typeof filters[key] !== 'undefined') { %>
            <input type="hidden" name="<%= key %>" value="<%= filters[key] %>">
          <% } %>
        <% } %>
        <% if(filters.amenities && filters.amenities.length > 0) { %>
          <% for(let a of filters.amenities) { %>
            <input type="hidden" name="amenities" value="<%= a %>">
          <% } %>
        <% } %>
        <select name="sort" id="sortSelect" class="form-select" style="width: auto; border-radius: 50px; padding: 0.45rem 1rem; font-size: 0.9rem;" aria-label="Sort rooms">
          <option value="">Sort: Default</option>
          <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
          <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
          <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
        </select>
      </form>
      <button class="btn btn-outline-dark d-lg-none" style="border-radius: 50px; font-size: 0.9rem;" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterDrawer" aria-controls="filterDrawer">
        <i class="fa-solid fa-sliders"></i> Filters
      </button>
    </div>
  </div>

  <% if(typeof activeFilters !== 'undefined' && activeFilters.length > 0) { %>
    <div class="active-filter-chips mb-3">
      <% for(let chip of activeFilters) { %>
        <a href="<%= chip.href %>" class="filter-chip">
          <%= chip.label %>
          <i class="fa-solid fa-xmark"></i>
        </a>
      <% } %>
      <a href="/listings" class="filter-chip filter-chip-clear">
        <i class="fa-solid fa-rotate-left"></i> Clear All
      </a>
    </div>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-3 d-none d-lg-block">
      <div class="filter-sidebar">
        <h6 class="filter-sidebar-title"><i class="fa-solid fa-sliders"></i> Filters</h6>
        <%- include("./includes/searchSidebar.ejs", { compact: true }) %>
      </div>
    </div>

    <div class="col-lg-9">
      <% if(allListings.length === 0) { %>
        <div class="empty-state text-center py-5">
          <div class="empty-state-illustration">
            <i class="fa-solid fa-house-circle-xmark"></i>
          </div>
          <h4>No rooms found</h4>
          <p class="text-muted">We couldn't find any rooms matching your search and filters.<br>Try adjusting your filters or clearing them to see more options.</p>
          <a href="/listings" class="btn btn-primary">
            <i class="fa-solid fa-rotate-left"></i> Clear Filters
          </a>
        </div>
      <% } else { %>
        <% if(hasSearch && matchingListings.length > 0) { %>
          <div class="search-result-group mb-4">
            <h3 class="search-result-heading">
              <i class="fa-solid fa-star me-1" style="color: #fdcb6e;"></i> Top Matching Rooms
            </h3>
            <div class="row g-4">
              <% for(let listing of matchingListings) { %>
                <div class="col-12 col-md-6 col-lg-4 reveal">
                  <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card h-100">
                      <div class="position-relative overflow-hidden">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                        <div class="card-badge">
                          <% if(listing.availability && listing.availability !== 'Available') { %>
                            <span class="badge bg-<%= listing.availability === 'Reserved' ? 'warning text-dark' : 'secondary' %>"><%= listing.availability %></span>
                          <% } else { %>
                            <span class="badge bg-primary">Available</span>
                          <% } %>
                        </div>
                        <div class="wishlist-icon" data-id="<%= listing._id %>">
                          <i class="fa-regular fa-heart"></i>
                        </div>
                      </div>
                      <div class="card-body">
                        <h5 class="card-title"><%= listing.title %></h5>
                        <p class="card-text mb-1">
                          <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                          <%= listing.location %>, <%= listing.country %>
                        </p>
                        <% if(listing.roomType) { %>
                          <p class="card-text mb-1">
                            <i class="fa-solid fa-bed" style="color: var(--primary);"></i>
                            <%= listing.roomType %>
                            <% if(listing.furnishing) { %> · <%= listing.furnishing %><% } %>
                          </p>
                        <% } %>
                        <% if(listing.genderPreference) { %>
                          <p class="card-text mb-1">
                            <i class="fa-solid fa-people-group" style="color: var(--primary);"></i>
                            <%= listing.genderPreference %>
                          </p>
                        <% } %>
                        <p class="price-text mt-2">
                          &#8377;<%= listing.price.toLocaleString("en-IN") %> <small style="font-size: 0.8rem; font-weight: 400; color: var(--text-secondary);">/ month</small>
                        </p>
                      </div>
                      <div class="card-footer d-flex justify-content-between align-items-center">
                        <small class="text-muted"><i class="fa-regular fa-star"></i> 4.5 (12 reviews)</small>
                        <% if(currUser) { %>
                          <a href="/listings/<%= listing._id %>" class="card-visit-btn">View Details</a>
                        <% } else { %>
                          <a href="/login" class="card-visit-btn">Login to View</a>
                        <% } %>
                      </div>
                    </div>
                  </a>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <% if(hasSearch && remainingListings.length > 0) { %>
          <div class="search-result-group">
            <h3 class="search-result-heading">
              <i class="fa-solid fa-layer-group me-1" style="color: var(--accent);"></i> Other Available Rooms
            </h3>
            <div class="row g-4">
              <% for(let listing of remainingListings) { %>
                <div class="col-12 col-md-6 col-lg-4 reveal">
                  <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card h-100">
                      <div class="position-relative overflow-hidden">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                        <div class="card-badge">
                          <% if(listing.availability && listing.availability !== 'Available') { %>
                            <span class="badge bg-<%= listing.availability === 'Reserved' ? 'warning text-dark' : 'secondary' %>"><%= listing.availability %></span>
                          <% } else { %>
                            <span class="badge bg-primary">Available</span>
                          <% } %>
                        </div>
                        <div class="wishlist-icon" data-id="<%= listing._id %>">
                          <i class="fa-regular fa-heart"></i>
                        </div>
                      </div>
                      <div class="card-body">
                        <h5 class="card-title"><%= listing.title %></h5>
                        <p class="card-text mb-1">
                          <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                          <%= listing.location %>, <%= listing.country %>
                        </p>
                        <% if(listing.roomType) { %>
                          <p class="card-text mb-1">
                            <i class="fa-solid fa-bed" style="color: var(--primary);"></i>
                            <%= listing.roomType %>
                            <% if(listing.furnishing) { %> · <%= listing.furnishing %><% } %>
                          </p>
                        <% } %>
                        <% if(listing.genderPreference) { %>
                          <p class="card-text mb-1">
                            <i class="fa-solid fa-people-group" style="color: var(--primary);"></i>
                            <%= listing.genderPreference %>
                          </p>
                        <% } %>
                        <p class="price-text mt-2">
                          &#8377;<%= listing.price.toLocaleString("en-IN") %> <small style="font-size: 0.8rem; font-weight: 400; color: var(--text-secondary);">/ month</small>
                        </p>
                      </div>
                      <div class="card-footer d-flex justify-content-between align-items-center">
                        <small class="text-muted"><i class="fa-regular fa-star"></i> 4.5 (12 reviews)</small>
                        <% if(currUser) { %>
                          <a href="/listings/<%= listing._id %>" class="card-visit-btn">View Details</a>
                        <% } else { %>
                          <a href="/login" class="card-visit-btn">Login to View</a>
                        <% } %>
                      </div>
                    </div>
                  </a>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>

        <% if(!hasSearch) { %>
          <div class="row g-4">
            <% for(let listing of allListings) { %>
              <div class="col-12 col-md-6 col-lg-4 reveal">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                  <div class="card listing-card h-100">
                    <div class="position-relative overflow-hidden">
                      <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                      <div class="card-badge">
                        <% if(listing.availability && listing.availability !== 'Available') { %>
                          <span class="badge bg-<%= listing.availability === 'Reserved' ? 'warning text-dark' : 'secondary' %>"><%= listing.availability %></span>
                        <% } else { %>
                          <span class="badge bg-primary">Available</span>
                        <% } %>
                      </div>
                      <div class="wishlist-icon" data-id="<%= listing._id %>">
                        <i class="fa-regular fa-heart"></i>
                      </div>
                    </div>
                    <div class="card-body">
                      <h5 class="card-title"><%= listing.title %></h5>
                      <p class="card-text mb-1">
                        <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                        <%= listing.location %>, <%= listing.country %>
                      </p>
                      <% if(listing.roomType) { %>
                        <p class="card-text mb-1">
                          <i class="fa-solid fa-bed" style="color: var(--primary);"></i>
                          <%= listing.roomType %>
                          <% if(listing.furnishing) { %> · <%= listing.furnishing %><% } %>
                        </p>
                      <% } %>
                      <% if(listing.genderPreference) { %>
                        <p class="card-text mb-1">
                          <i class="fa-solid fa-people-group" style="color: var(--primary);"></i>
                          <%= listing.genderPreference %>
                        </p>
                      <% } %>
                      <p class="price-text mt-2">
                        &#8377;<%= listing.price.toLocaleString("en-IN") %> <small style="font-size: 0.8rem; font-weight: 400; color: var(--text-secondary);">/ month</small>
                      </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                      <small class="text-muted"><i class="fa-regular fa-star"></i> 4.5 (12 reviews)</small>
                      <% if(currUser) { %>
                        <a href="/listings/<%= listing._id %>" class="card-visit-btn">View Details</a>
                      <% } else { %>
                        <a href="/login" class="card-visit-btn">Login to View</a>
                      <% } %>
                    </div>
                  </div>
                </a>
              </div>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<!-- Mobile Filter Drawer (Bootstrap Offcanvas) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="filterDrawer" aria-labelledby="filterDrawerLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="filterDrawerLabel"><i class="fa-solid fa-sliders"></i> Filter Rooms</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%- include("./includes/searchSidebar.ejs", { compact: true }) %>
  </div>
</div>
