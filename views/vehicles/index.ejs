<% layout("/layouts/boilerplate") %>

<!-- ============================================ -->
<!-- VEHICLE HERO SECTION                         -->
<!-- ============================================ -->
<section class="vehicle-hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div class="vehicle-hero-content">
          <span class="vehicle-hero-badge"><i class="fa-solid fa-car"></i> Student Vehicle Rentals</span>
          <h1>
            Rent Cars &amp; Bikes<br>
            <span class="highlight">For Your Daily Commute</span>
          </h1>
          <p>Discover affordable cars, bikes, and scooters for rent. Flexible daily, weekly, and monthly plans near your college.</p>

          <!-- Vehicle Search -->
          <form class="vehicle-hero-search" action="/vehicles" method="GET">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" name="q" placeholder="Search by vehicle, brand, city, or area..." value="<%= typeof filters !== 'undefined' ? filters.q : '' %>">
            <button class="vehicle-hero-search-btn" type="submit">Search Vehicles</button>
          </form>

          <!-- Vehicle Stats -->
          <div class="vehicle-hero-stats">
            <div class="stat-item">
              <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.totalVehicles : 0 %>+</div>
              <div class="stat-label">Vehicles</div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.totalCities : 0 %></div>
              <div class="stat-label">Cities</div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.totalOwners : 0 %>+</div>
              <div class="stat-label">Trusted Owners</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="vehicle-hero-image-wrapper">
          <img src="https://images.unsplash.com/photo-1555215695-3004980ad54e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Vehicle rental" class="img-fluid">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================ -->
<!-- VEHICLE LISTINGS + SEARCH & FILTERS          -->
<!-- ============================================ -->
<div class="container mt-4 mb-5">
  <!-- Section Header + Mobile Filter Toggle -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
      <h2 class="section-title mb-1">Explore Vehicles</h2>
      <p class="text-muted mb-0">Showing <%= typeof allVehicles !== 'undefined' ? allVehicles.length : 0 %> vehicle(s)</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <!-- Mobile: Open filter drawer -->
      <button class="btn btn-outline-dark d-lg-none" style="border-radius: 50px; font-size: 0.9rem;" type="button" data-bs-toggle="offcanvas" data-bs-target="#vehicleFilterDrawer" aria-controls="vehicleFilterDrawer">
        <i class="fa-solid fa-sliders"></i> Filters
      </button>
    </div>
  </div>

  <!-- Active Filter Chips -->
  <% if(typeof activeFilters !== 'undefined' && activeFilters.length > 0) { %>
    <div class="active-filter-chips mb-3">
      <% for(let chip of activeFilters) { %>
        <a href="<%= chip.href %>" class="filter-chip">
          <%= chip.label %>
          <i class="fa-solid fa-xmark"></i>
        </a>
      <% } %>
      <a href="/vehicles" class="filter-chip filter-chip-clear">
        <i class="fa-solid fa-rotate-left"></i> Clear All
      </a>
    </div>
  <% } %>

  <!-- Results grid: sidebar + vehicles -->
  <div class="row g-4">
    <!-- Desktop Filter Sidebar -->
    <div class="col-lg-3 d-none d-lg-block">
      <div class="filter-sidebar">
        <h6 class="filter-sidebar-title"><i class="fa-solid fa-sliders"></i> Filters</h6>
        <%- include("./includes/searchSidebar.ejs") %>
      </div>
    </div>

    <!-- Vehicles Column -->
    <div class="col-lg-9">
      <% if(typeof allVehicles === 'undefined' || allVehicles.length === 0) { %>
        <!-- Professional Empty State -->
        <div class="empty-state text-center py-5">
          <div class="empty-state-illustration">
            <i class="fa-solid fa-car"></i>
          </div>
          <h4>No vehicles found</h4>
          <p class="text-muted">We couldn't find any vehicles matching your search and filters.<br>Try adjusting your filters or clearing them to see more options.</p>
          <a href="/vehicles" class="btn btn-primary">
            <i class="fa-solid fa-rotate-left"></i> Clear Filters
          </a>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% for(let vehicle of allVehicles) { %>
            <div class="col-12 col-md-6 col-lg-4 reveal">
              <a href="/vehicles/<%= vehicle._id %>" class="vehicle-link">
                <div class="card vehicle-card h-100">
                  <div class="position-relative overflow-hidden">
                    <img src="<%= vehicle.image.url %>" class="card-img-top" alt="<%= vehicle.name %>">
                    <div class="vehicle-card-badge">
                      <span class="badge bg-<%= vehicle.vehicleType === 'Car' ? 'primary' : 'success' %>"><%= vehicle.vehicleType %></span>
                    </div>
                    <div class="vehicle-status-badge">
                      <% if(vehicle.availability === 'Available') { %>
                        <span class="badge bg-success">Available</span>
                      <% } else if(vehicle.availability === 'Rented') { %>
                        <span class="badge bg-warning text-dark">Rented</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Maintenance</span>
                      <% } %>
                    </div>
                  </div>
                  <div class="card-body">
                    <h5 class="card-title"><%= vehicle.name %></h5>
                    <p class="card-text mb-1">
                      <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                      <%= vehicle.city || vehicle.location || 'Location not set' %>
                    </p>
                    <p class="card-text mb-1 text-muted small">
                      <i class="fa-solid fa-tag" style="color: var(--primary);"></i>
                      <%= [vehicle.brand, vehicle.model, vehicle.fuelType].filter(Boolean).join(' · ') || 'No specs' %>
                    </p>
                    <p class="price-text mt-2 mb-0">
                      &#8377;<%= vehicle.dailyPrice.toLocaleString("en-IN") %> <small style="font-size: 0.8rem; font-weight: 400; color: var(--text-secondary);">/ day</small>
                    </p>
                  </div>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Mobile Filter Drawer (Bootstrap Offcanvas) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="vehicleFilterDrawer" aria-labelledby="vehicleFilterDrawerLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="vehicleFilterDrawerLabel"><i class="fa-solid fa-sliders"></i> Filter Vehicles</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%- include("./includes/searchSidebar.ejs") %>
  </div>
</div>
