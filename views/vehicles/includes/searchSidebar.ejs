<!-- ============================================ -->
<!-- VEHICLE SEARCH & FILTER SIDEBAR              -->
<!-- ============================================ -->
<%
  const f = typeof filters !== 'undefined' ? filters : {};
  const vt = typeof vehicleTypes !== 'undefined' ? vehicleTypes : [];
  const ft = typeof fuelTypes !== 'undefined' ? fuelTypes : [];
  const gt = typeof gearTypes !== 'undefined' ? gearTypes : [];
  const ao = typeof availabilityOptions !== 'undefined' ? availabilityOptions : ['Available', 'Rented', 'Maintenance'];
%>

<form action="/vehicles" method="GET" class="filter-form">
  <!-- Search by name / brand / city / area -->
  <div class="filter-group">
    <label class="filter-label" for="vehicleQ">Search</label>
    <div class="input-group input-group-sm">
      <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
      <input type="text" class="form-control" id="vehicleQ" name="q" placeholder="Name, brand, city, area..." value="<%= f.q || '' %>">
    </div>
  </div>

  <!-- City -->
  <div class="filter-group">
    <label class="filter-label" for="vehicleCity">City</label>
    <input type="text" class="form-control form-control-sm" id="vehicleCity" name="city" placeholder="e.g. Nagpur" value="<%= f.city || '' %>">
  </div>

  <!-- Location / Area -->
  <div class="filter-group">
    <label class="filter-label" for="vehicleLocation">Area / Location</label>
    <input type="text" class="form-control form-control-sm" id="vehicleLocation" name="location" placeholder="e.g. Trimurti Nagar" value="<%= f.location || '' %>">
  </div>

  <!-- Daily Price (Min/Max) -->
  <div class="filter-group">
    <label class="filter-label">Daily Price (&#8377;)</label>
    <div class="row g-2">
      <div class="col-6">
        <input type="number" class="form-control form-control-sm" name="minPrice" placeholder="Min" min="0" value="<%= f.minPrice || '' %>">
      </div>
      <div class="col-6">
        <input type="number" class="form-control form-control-sm" name="maxPrice" placeholder="Max" min="0" value="<%= f.maxPrice || '' %>">
      </div>
    </div>
  </div>

  <!-- Vehicle Type -->
  <div class="filter-group">
    <label class="filter-label">Vehicle Type</label>
    <select name="vehicleType" class="form-select form-select-sm">
      <option value="">All Types</option>
      <% for(let t of vt) { %>
        <option value="<%= t %>" <%= f.vehicleType === t ? 'selected' : '' %>><%= t %></option>
      <% } %>
    </select>
  </div>

  <!-- Fuel Type -->
  <div class="filter-group">
    <label class="filter-label">Fuel Type</label>
    <select name="fuelType" class="form-select form-select-sm">
      <option value="">Any Fuel</option>
      <% for(let t of ft) { %>
        <option value="<%= t %>" <%= f.fuelType === t ? 'selected' : '' %>><%= t %></option>
      <% } %>
    </select>
  </div>

  <!-- Gear Type -->
  <div class="filter-group">
    <label class="filter-label">Gear Type</label>
    <select name="gearType" class="form-select form-select-sm">
      <option value="">Any Gear</option>
      <% for(let g of gt) { %>
        <option value="<%= g %>" <%= f.gearType === g ? 'selected' : '' %>><%= g %></option>
      <% } %>
    </select>
  </div>

  <!-- Availability -->
  <div class="filter-group">
    <label class="filter-label">Availability</label>
    <select name="availability" class="form-select form-select-sm">
      <option value="">Any Availability</option>
      <% for(let o of ao) { %>
        <option value="<%= o %>" <%= f.availability === o ? 'selected' : '' %>><%= o %></option>
      <% } %>
    </select>
  </div>

  <!-- Actions -->
  <div class="d-grid gap-2 mt-4">
    <button type="submit" class="btn btn-primary btn-sm">
      <i class="fa-solid fa-magnifying-glass"></i> Apply Filters
    </button>
    <a href="/vehicles" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-rotate-left"></i> Clear Filters
    </a>
  </div>
</form>
