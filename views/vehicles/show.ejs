<% layout("/layouts/boilerplate") %>
<%
  let allImages = [];
  if(vehicle.images && vehicle.images.length > 0) {
    allImages = vehicle.images;
  } else if(vehicle.image && vehicle.image.url) {
    allImages = [vehicle.image];
  }
  let mainImage = allImages.length > 0 ? allImages[0] : null;
%>

<!-- ============================================ -->
<!-- VEHICLE PAGE HEADER                          -->
<!-- ============================================ -->
<div class="show-page-header mt-4">
  <div class="row">
    <div class="col-lg-8">
      <h2><%= vehicle.name %></h2>
      <p class="location-text">
        <i class="fa-solid fa-location-dot"></i>
        <%= [vehicle.address, vehicle.city, vehicle.location].filter(Boolean).join(', ') || 'Location not set' %>
      </p>
    </div>
    <div class="col-lg-4 text-lg-end">
      <% if(vehicle.availability === 'Available') { %>
        <span class="badge bg-success status-badge" style="font-size: 0.8rem; padding: 0.5em 1em; border-radius: 50px;">Available</span>
      <% } else if(vehicle.availability === 'Rented') { %>
        <span class="badge bg-warning text-dark status-badge" style="font-size: 0.8rem; padding: 0.5em 1em; border-radius: 50px;">Rented</span>
      <% } else { %>
        <span class="badge bg-secondary status-badge" style="font-size: 0.8rem; padding: 0.5em 1em; border-radius: 50px;">Maintenance</span>
      <% } %>
    </div>
  </div>
</div>

<!-- ============================================ -->
<!-- GALLERY + CONTACT CARD                       -->
<!-- ============================================ -->
<div class="row g-4">
  <!-- Left Column: Gallery + Details -->
  <div class="col-lg-8">
    <!-- Gallery -->
    <div class="gallery-section">
      <% if(mainImage) { %>
        <div class="gallery-main">
          <img id="vehicleGalleryMain" src="<%= mainImage.url %>" alt="<%= vehicle.name %>" class="w-100">
        </div>
      <% } %>
      <% if(allImages.length > 1) { %>
        <div class="gallery-thumbs">
          <% for(let i = 0; i < allImages.length && i < 5; i++) { %>
            <img src="<%= allImages[i].url %>" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" alt="View <%= i + 1 %>" onclick="document.getElementById('vehicleGalleryMain').src=this.src; document.querySelectorAll('.gallery-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');">
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Vehicle Info Grid -->
    <div class="vehicle-info-grid">
      <div class="vehicle-info-item">
        <i class="fa-solid fa-car"></i>
        <div class="info-label">Vehicle Type</div>
        <div class="info-value"><%= vehicle.vehicleType || 'N/A' %></div>
      </div>
      <div class="vehicle-info-item">
        <i class="fa-solid fa-tag"></i>
        <div class="info-label">Brand</div>
        <div class="info-value"><%= vehicle.brand || 'N/A' %></div>
      </div>
      <div class="vehicle-info-item">
        <i class="fa-solid fa-circle-info"></i>
        <div class="info-label">Model</div>
        <div class="info-value"><%= vehicle.model || 'N/A' %></div>
      </div>
      <div class="vehicle-info-item">
        <i class="fa-solid fa-gas-pump"></i>
        <div class="info-label">Fuel</div>
        <div class="info-value"><%= vehicle.fuelType || 'N/A' %></div>
      </div>
      <div class="vehicle-info-item">
        <i class="fa-solid fa-users"></i>
        <div class="info-label">Seats</div>
        <div class="info-value"><%= vehicle.seats || 'N/A' %></div>
      </div>
      <div class="vehicle-info-item">
        <i class="fa-solid fa-gears"></i>
        <div class="info-label">Gear</div>
        <div class="info-value"><%= vehicle.gearType || 'N/A' %></div>
      </div>
      <div class="vehicle-info-item">
        <i class="fa-solid fa-gauge-high"></i>
        <div class="info-label">Mileage</div>
        <div class="info-value"><%= vehicle.mileage || 'N/A' %></div>
      </div>
      <div class="vehicle-info-item">
        <i class="fa-solid fa-city"></i>
        <div class="info-label">City</div>
        <div class="info-value"><%= vehicle.city || 'N/A' %></div>
      </div>
    </div>

    <!-- Pricing -->
    <div class="mb-4">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-indian-rupee-sign"></i> Rental Pricing</h5>
      <div class="vehicle-pricing-grid">
        <div class="vehicle-price-card">
          <div class="price-label">Daily</div>
          <div class="price-value">&#8377;<%= vehicle.dailyPrice ? vehicle.dailyPrice.toLocaleString("en-IN") : 'N/A' %></div>
        </div>
        <div class="vehicle-price-card">
          <div class="price-label">Weekly</div>
          <div class="price-value">&#8377;<%= vehicle.weeklyPrice ? vehicle.weeklyPrice.toLocaleString("en-IN") : 'N/A' %></div>
        </div>
        <div class="vehicle-price-card">
          <div class="price-label">Monthly</div>
          <div class="price-value">&#8377;<%= vehicle.monthlyPrice ? vehicle.monthlyPrice.toLocaleString("en-IN") : 'N/A' %></div>
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="mb-4">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-file-lines"></i> About this Vehicle</h5>
      <p class="text-secondary"><%= vehicle.description || 'No description provided.' %></p>
    </div>

    <!-- Address -->
    <div class="mb-4">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-location-dot"></i> Pickup Location</h5>
      <p class="text-secondary mb-0"><%= vehicle.address || 'Address not provided.' %></p>
    </div>

    <!-- Owner Card -->
    <div class="owner-card mb-4">
      <div class="d-flex align-items-center gap-3">
        <div class="owner-avatar">
          <%= vehicle.owner ? vehicle.owner.username.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="flex-grow-1">
          <div class="owner-name"><%= vehicle.owner ? vehicle.owner.username : 'Unknown' %></div>
          <div class="owner-meta"><i class="fa-solid fa-house"></i> Vehicle Owner</div>
        </div>
        <% if(isOwnerOfVehicle) { %>
          <a href="/vehicles/<%= vehicle._id %>/edit" class="btn btn-outline-primary btn-sm" style="border-radius: 50px;">
            <i class="fa-solid fa-pen"></i> Edit
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right Column: Contact Card -->
  <div class="col-lg-4">
    <div class="sticky-contact-card">
      <div class="price-display mb-3">
        &#8377;<%= vehicle.dailyPrice ? vehicle.dailyPrice.toLocaleString("en-IN") : 'N/A' %>
        <small>/ day</small>
      </div>
      <hr>
      <div class="mb-3">
        <p class="mb-1"><i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> <%= vehicle.city || 'N/A' %></p>
        <p class="mb-1"><i class="fa-solid fa-car" style="color: var(--primary);"></i> <%= vehicle.vehicleType || 'N/A' %></p>
        <p class="mb-1"><i class="fa-solid fa-tag" style="color: var(--primary);"></i> <%= [vehicle.brand, vehicle.model].filter(Boolean).join(' ') || 'N/A' %></p>
        <p class="mb-1"><i class="fa-solid fa-gas-pump" style="color: var(--primary);"></i> <%= vehicle.fuelType || 'N/A' %></p>
      </div>
      <hr>
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="profile-avatar" style="width: 44px; height: 44px; font-size: 1.1rem;">
          <%= vehicle.owner ? vehicle.owner.username.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div>
          <strong><%= vehicle.owner ? vehicle.owner.username : 'Unknown' %></strong><br>
          <small class="text-muted">Vehicle Owner</small>
        </div>
      </div>
      <% if(isOwnerOfVehicle) { %>
        <a href="/vehicles/<%= vehicle._id %>/edit" class="btn btn-book mb-2"><i class="fa-solid fa-pen"></i> Edit Vehicle</a>
      <% } else { %>
        <% if(currUser && currUser.role === 'student') { %><a href="/payments/checkout/vehicle/<%= vehicle._id %>" class="btn btn-success w-100 mb-2"><i class="fa-solid fa-lock"></i> Rent & Pay</a><% } %>
        <a href="tel:<%= vehicle.contactNumber || '' %>" class="btn btn-book mb-2"><i class="fa-solid fa-phone"></i> Contact for Rental</a>
      <% } %>
      <hr>
      <div class="text-center text-muted" style="font-size: 0.8rem;">
        <i class="fa-solid fa-shield-check"></i> Contact directly for availability &amp; pricing
      </div>
    </div>
  </div>
</div>
