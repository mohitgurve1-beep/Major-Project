<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <h3><i class="fa-solid fa-car"></i> Edit Vehicle</h3>
        <p class="text-muted">Update the details of your vehicle so students keep finding accurate info.</p>
        <form action="/vehicles/<%= vehicle._id %>?_method=PUT" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="name" class="form-label">Vehicle Name *</label>
                <input type="text" name="vehicle[name]" id="name" placeholder="e.g. Honda Activa 2022" class="form-control" value="<%= vehicle.name %>" required>
                <div class="invalid-feedback">Please provide a vehicle name.</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="vehicle[description]" id="description" class="form-control" rows="3" placeholder="Short description of the vehicle"><%= vehicle.description || '' %></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Current Images</label>
                <div class="row g-2">
                    <% if(vehicle.images && vehicle.images.length > 0) { %>
                        <% for(let img of vehicle.images) { %>
                            <div class="col-md-3 col-6">
                                <div class="position-relative">
                                    <img src="<%= img.url.replace('/upload', '/upload/w_250') %>" alt="Vehicle image" class="img-fluid rounded" style="max-height: 150px; width: 100%; object-fit: cover;">
                                    <div class="form-check mt-1">
                                        <input class="form-check-input" type="checkbox" name="deleteImages" value="<%= img.filename %>" id="del-vehicle-<%= img.filename %>">
                                        <label class="form-check-label text-danger small" for="del-vehicle-<%= img.filename %>">Delete</label>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } else { %>
                        <p class="text-muted">No images uploaded yet.</p>
                    <% } %>
                </div>
            </div>

            <div class="mb-3">
                <label for="images" class="form-label">Upload New Images</label>
                <input type="file" name="images" id="images" class="form-control" multiple accept="image/*">
                <small class="text-muted">You can select multiple images. Max 10 images, 8MB each.</small>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="vehicleType" class="form-label">Vehicle Type</label>
                    <select name="vehicle[vehicleType]" id="vehicleType" class="form-select">
                        <option value="">Select Type</option>
                        <% for(let t of vehicleTypes) { %>
                            <option value="<%= t %>" <%= vehicle.vehicleType === t ? 'selected' : '' %>><%= t %></option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="brand" class="form-label">Brand</label>
                    <input type="text" name="vehicle[brand]" id="brand" placeholder="e.g. Honda" class="form-control" value="<%= vehicle.brand || '' %>">
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="model" class="form-label">Model</label>
                    <input type="text" name="vehicle[model]" id="model" placeholder="e.g. Activa 2022" class="form-control" value="<%= vehicle.model || '' %>">
                </div>
                <div class="mb-3 col-md-6">
                    <label for="fuelType" class="form-label">Fuel Type</label>
                    <select name="vehicle[fuelType]" id="fuelType" class="form-select">
                        <option value="">Select Fuel</option>
                        <% for(let t of fuelTypes) { %>
                            <option value="<%= t %>" <%= vehicle.fuelType === t ? 'selected' : '' %>><%= t %></option>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="dailyPrice" class="form-label">Daily Price (&#8377;) *</label>
                    <input type="number" name="vehicle[dailyPrice]" id="dailyPrice" placeholder="e.g. 500" min="0" class="form-control" value="<%= vehicle.dailyPrice %>" required>
                    <div class="invalid-feedback">Daily price should be valid.</div>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="weeklyPrice" class="form-label">Weekly Price (&#8377;)</label>
                    <input type="number" name="vehicle[weeklyPrice]" id="weeklyPrice" placeholder="e.g. 3000" min="0" class="form-control" value="<%= vehicle.weeklyPrice || '' %>">
                </div>
                <div class="mb-3 col-md-4">
                    <label for="monthlyPrice" class="form-label">Monthly Price (&#8377;)</label>
                    <input type="number" name="vehicle[monthlyPrice]" id="monthlyPrice" placeholder="e.g. 10000" min="0" class="form-control" value="<%= vehicle.monthlyPrice || '' %>">
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="seats" class="form-label">Seats</label>
                    <input type="number" name="vehicle[seats]" id="seats" placeholder="e.g. 2 or 5" min="1" max="20" class="form-control" value="<%= vehicle.seats || '' %>">
                </div>
                <div class="mb-3 col-md-4">
                    <label for="gearType" class="form-label">Gear Type</label>
                    <select name="vehicle[gearType]" id="gearType" class="form-select">
                        <option value="">Select Gear</option>
                        <% for(let g of gearTypes) { %>
                            <option value="<%= g %>" <%= vehicle.gearType === g ? 'selected' : '' %>><%= g %></option>
                        <% } %>
                    </select>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="mileage" class="form-label">Mileage</label>
                    <input type="text" name="vehicle[mileage]" id="mileage" placeholder="e.g. 45 kmpl" class="form-control" value="<%= vehicle.mileage || '' %>">
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="address" class="form-label">Address</label>
                    <input type="text" name="vehicle[address]" id="address" placeholder="Street, building, landmark" class="form-control" value="<%= vehicle.address || '' %>">
                </div>
                <div class="mb-3 col-md-6">
                    <label for="city" class="form-label">City</label>
                    <input type="text" name="vehicle[city]" id="city" placeholder="e.g. Nagpur" class="form-control" value="<%= vehicle.city || '' %>">
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="location" class="form-label">Area / Location</label>
                    <input type="text" name="vehicle[location]" id="location" placeholder="e.g. Trimurti Nagar" class="form-control" value="<%= vehicle.location || '' %>">
                </div>
                <div class="mb-3 col-md-6">
                    <label for="contactNumber" class="form-label">Contact Number</label>
                    <input type="text" name="vehicle[contactNumber]" id="contactNumber" placeholder="+91 98765 43210" class="form-control" value="<%= vehicle.contactNumber || '' %>">
                </div>
            </div>

            <div class="mb-3">
                <label for="mapLocation" class="form-label">Google Map Location</label>
                <input type="text" name="vehicle[mapLocation]" id="mapLocation" placeholder="Google Maps link or coordinates" class="form-control" value="<%= vehicle.mapLocation || '' %>">
            </div>

            <div class="mb-3">
                <label for="availability" class="form-label">Availability</label>
                <select name="vehicle[availability]" id="availability" class="form-select">
                    <option value="">Select Availability</option>
                    <% for(let o of availabilityOptions) { %>
                        <option value="<%= o %>" <%= vehicle.availability === o ? 'selected' : '' %>><%= o %></option>
                    <% } %>
                </select>
            </div>

            <button class="btn btn-dark add-btn mt-3"><i class="fa-solid fa-pen"></i> Update Vehicle</button>
            <a href="/vehicles/<%= vehicle._id %>" class="btn btn-outline-secondary mt-3">Cancel</a>
        </form>
    </div>
</div>
