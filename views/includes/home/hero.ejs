<%
  // Premium Hero Section (Section 3) + Auto-changing background (Feature 1).
  // Reusable hero slider partial.
  const heroSlides = [
    { img: "https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80", alt: "Modern student room" },
    { img: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80", alt: "Cozy apartment living room" },
    { img: "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80", alt: "Bright furnished room" },
    { img: "https://images.unsplash.com/photo-1493809842364-78817add7ffb?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80", alt: "Student-friendly studio" },
  ];
  const heroStats = typeof stats !== 'undefined' ? stats : {};
  const heroRoomTypes = typeof roomTypes !== 'undefined' ? roomTypes : [];
  const heroFurnishing = typeof furnishingOptions !== 'undefined' ? furnishingOptions : [];
  const heroGender = typeof genderOptions !== 'undefined' ? genderOptions : [];
  const heroAvailability = typeof availabilityOptions !== 'undefined' ? availabilityOptions : [];
%>
<section class="home-hero">
  <div id="homeHeroCarousel" class="carousel slide home-hero-carousel carousel-fade" data-bs-ride="carousel" data-bs-interval="6000">
    <div class="carousel-inner home-hero-inner">
      <% heroSlides.forEach((slide, i) => { %>
        <div class="carousel-item home-hero-slide <%= i === 0 ? 'active' : '' %>" style="background-image:url('<%= slide.img %>');"></div>
      <% }) %>
    </div>
    <button class="carousel-control-prev home-hero-ctrl" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next home-hero-ctrl" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
    <div class="carousel-indicators home-hero-dots">
      <% heroSlides.forEach((slide, i) => { %>
        <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" aria-label="Slide <%= i + 1 %>"></button>
      <% }) %>
    </div>
    <div class="home-hero-overlay"></div>
  </div>

  <div class="container home-hero-content">
    <div class="row align-items-center g-4">
      <div class="col-lg-6">
        <div class="home-hero-left">
          <span class="home-hero-badge"><i class="fa-solid fa-graduation-cap"></i> Trusted Student Housing Platform</span>
          <h1 class="home-hero-title">
            Find Comfortable<br>
            <span>Rooms for Monthly Rent</span>
          </h1>
          <p class="home-hero-desc">
            Discover verified, affordable rooms near your college. Safe, secure, and student-friendly rentals at your fingertips.
          </p>
          <div class="home-hero-features">
            <span><i class="fa-solid fa-circle-check"></i> Verified Listings</span>
            <span><i class="fa-solid fa-circle-check"></i> No Brokerage</span>
            <span><i class="fa-solid fa-circle-check"></i> Safe &amp; Secure</span>
            <span><i class="fa-solid fa-circle-check"></i> Best Prices</span>
          </div>
          <div class="home-hero-stats">
            <div class="home-hero-stat">
              <div class="num"><%= heroStats.totalRooms || 0 %>+</div>
              <div class="lbl">Verified Rooms</div>
            </div>
            <div class="home-hero-stat">
              <div class="num"><%= heroStats.totalOwners || 0 %>+</div>
              <div class="lbl">Trusted Owners</div>
            </div>
            <div class="home-hero-stat">
              <div class="num"><%= heroStats.totalStudents || 0 %>+</div>
              <div class="lbl">Happy Students</div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="home-hero-search-card">
          <!-- Tabs -->
          <ul class="nav nav-pills home-hero-tabs" id="heroTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabRooms" type="button" role="tab">
                <i class="fa-solid fa-bed"></i> Rooms
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabMess" type="button" role="tab">
                <i class="fa-solid fa-utensils"></i> Mess
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabLaundry" type="button" role="tab">
                <i class="fa-solid fa-shirt"></i> Laundry
              </button>
            </li>
          </ul>

          <div class="tab-content">
            <!-- ROOMS SEARCH -->
            <div class="tab-pane fade show active" id="tabRooms" role="tabpanel">
              <form action="/listings" method="GET" class="home-hero-form">
                <div class="row g-3">
                  <div class="col-12">
                    <label class="home-form-label"><i class="fa-solid fa-location-dot"></i> Location</label>
                    <input type="text" class="form-control home-form-control" name="location" placeholder="City or area, e.g. Nagpur">
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-bed"></i> Room Type</label>
                    <select class="form-select home-form-control" name="roomType">
                      <option value="">Any Type</option>
                      <% for(let t of heroRoomTypes){ %><option value="<%= t %>"><%= t %></option><% } %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-indian-rupee-sign"></i> Budget</label>
                    <select class="form-select home-form-control" name="maxRent">
                      <option value="">Any Budget</option>
                      <option value="5000">Under ₹5,000</option>
                      <option value="8000">Under ₹8,000</option>
                      <option value="12000">Under ₹12,000</option>
                      <option value="15000">Under ₹15,000</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-people-group"></i> Gender</label>
                    <select class="form-select home-form-control" name="genderPreference">
                      <option value="">Anyone</option>
                      <% for(let g of heroGender){ %><option value="<%= g %>"><%= g %></option><% } %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-people-roof"></i> Sharing</label>
                    <select class="form-select home-form-control" name="roomType">
                      <option value="">Any</option>
                      <option value="Single Room">Single</option>
                      <option value="Shared Room">Shared</option>
                      <option value="PG">PG</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-couch"></i> Furnishing</label>
                    <select class="form-select home-form-control" name="furnishing">
                      <option value="">Any</option>
                      <% for(let fu of heroFurnishing){ %><option value="<%= fu %>"><%= fu %></option><% } %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-circle-check"></i> Availability</label>
                    <select class="form-select home-form-control" name="availability">
                      <option value="">Any</option>
                      <% for(let av of heroAvailability){ %><option value="<%= av %>"><%= av %></option><% } %>
                    </select>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="home-btn-primary home-hero-search-btn w-100">
                      <i class="fa-solid fa-magnifying-glass"></i> Search Rooms
                    </button>
                  </div>
                </div>
              </form>
            </div>

            <!-- MESS SEARCH -->
            <div class="tab-pane fade" id="tabMess" role="tabpanel">
              <form action="/messes" method="GET" class="home-hero-form">
                <div class="row g-3">
                  <div class="col-12">
                    <label class="home-form-label"><i class="fa-solid fa-location-dot"></i> Location</label>
                    <input type="text" class="form-control home-form-control" name="location" placeholder="City or area">
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-indian-rupee-sign"></i> Monthly Price</label>
                    <select class="form-select home-form-control" name="maxPrice">
                      <option value="">Any Budget</option>
                      <option value="3000">Under ₹3,000</option>
                      <option value="5000">Under ₹5,000</option>
                      <option value="8000">Under ₹8,000</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="home-form-label"><i class="fa-solid fa-utensils"></i> Meal Type</label>
                    <select class="form-select home-form-control" name="mealType">
                      <option value="">Both</option>
                      <option value="Veg">Veg</option>
                      <option value="Non-Veg">Non-Veg</option>
                    </select>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="home-btn-primary home-hero-search-btn w-100">
                      <i class="fa-solid fa-magnifying-glass"></i> Search Mess
                    </button>
                  </div>
                </div>
              </form>
            </div>

            <!-- LAUNDRY SEARCH -->
            <div class="tab-pane fade" id="tabLaundry" role="tabpanel">
              <form action="/laundry" method="GET" class="home-hero-form">
                <div class="row g-3">
                  <div class="col-12">
                    <label class="home-form-label"><i class="fa-solid fa-location-dot"></i> Location</label>
                    <input type="text" class="form-control home-form-control" name="location" placeholder="City or area">
                  </div>
                  <div class="col-12">
                    <label class="home-form-label"><i class="fa-solid fa-shirt"></i> Service</label>
                    <div class="d-flex flex-wrap gap-2">
                      <label class="home-check-chip"><input type="checkbox" name="pickupAvailable" value="on"> Pickup</label>
                      <label class="home-check-chip"><input type="checkbox" name="deliveryAvailable" value="on"> Delivery</label>
                      <label class="home-check-chip"><input type="checkbox" name="sameDayService" value="on"> Same Day</label>
                    </div>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="home-btn-primary home-hero-search-btn w-100">
                      <i class="fa-solid fa-magnifying-glass"></i> Search Laundry
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
