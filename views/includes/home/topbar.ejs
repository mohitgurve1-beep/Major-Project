<%
  // Slim dark top information bar (Section 1).
  const tbLocation = 'Nagpur, Maharashtra';
  const tbEmail = 'support@studentaccommodation.in';
  const tbPhone = '+91 98765 43210';
%>
<div class="home-topbar d-none d-md-block">
  <div class="container d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-4">
      <span class="home-topbar-item"><i class="fa-solid fa-location-dot"></i> <%= tbLocation %></span>
      <a href="mailto:<%= tbEmail %>" class="home-topbar-item"><i class="fa-solid fa-envelope"></i> <%= tbEmail %></a>
    </div>
    <div class="d-flex align-items-center gap-3">
      <a href="tel:<%= tbPhone %>" class="home-topbar-item"><i class="fa-solid fa-phone"></i> <%= tbPhone %></a>
      <span class="home-topbar-divider"></span>
      <div class="d-flex align-items-center gap-2">
        <a href="#" class="home-topbar-social" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
        <a href="#" class="home-topbar-social" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
        <a href="#" class="home-topbar-social" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
        <a href="#" class="home-topbar-social" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
        <a href="#" class="home-topbar-social" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
      </div>
    </div>
  </div>
</div>
