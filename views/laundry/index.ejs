<% layout("/layouts/boilerplate") %>

<!-- ============================================ -->
<!-- LAUNDRY HERO SECTION                         -->
<!-- ============================================ -->
<section class="laundry-hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div class="laundry-hero-content">
          <span class="laundry-hero-badge"><i class="fa-solid fa-shirt"></i> Student Laundry Services</span>
          <h1>
            Fresh &amp; Clean Laundry<br>
            <span class="highlight">For Every Student</span>
          </h1>
          <p>Discover reliable laundry services with wash &amp; fold, ironing, and dry cleaning. Pickup, delivery, and same-day options available near you.</p>

          <!-- Laundry Search -->
          <form class="laundry-hero-search" action="/laundry" method="GET">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" name="q" placeholder="Search by service name, city, or area..." value="<%= typeof filters !== 'undefined' ? filters.q : '' %>">
            <button class="laundry-hero-search-btn" type="submit">Search Laundry</button>
          </form>

          <!-- Laundry Stats -->
          <div class="laundry-hero-stats">
            <div class="stat-item">
              <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.totalLaundries : 0 %>+</div>
              <div class="stat-label">Services</div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.totalCities : 0 %></div>
              <div class="stat-label">Cities</div>
            </div>
            <div class="stat-item">
              <div class="stat-number"><%= typeof stats !== 'undefined' ? stats.totalOwners : 0 %>+</div>
              <div class="stat-label">Trusted Owners</div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="laundry-hero-image-wrapper">
          <img src="https://images.unsplash.com/photo-1545173168-9f1947eebb7f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Laundry service" class="img-fluid">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============================================ -->
<!-- LAUNDRY LISTINGS + SEARCH & FILTERS          -->
<!-- ============================================ -->
<div class="container mt-4 mb-5">
  <!-- Section Header + Mobile Filter Toggle -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
      <h2 class="section-title mb-1">Explore Laundry Services</h2>
      <p class="text-muted mb-0">Showing <%= typeof allLaundries !== 'undefined' ? allLaundries.length : 0 %> service(s)</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <!-- Mobile: Open filter drawer -->
      <button class="btn btn-outline-dark d-lg-none" style="border-radius: 50px; font-size: 0.9rem;" type="button" data-bs-toggle="offcanvas" data-bs-target="#laundryFilterDrawer" aria-controls="laundryFilterDrawer">
        <i class="fa-solid fa-sliders"></i> Filters
      </button>
    </div>
  </div>

  <!-- Active Filter Chips -->
  <% if(typeof activeFilters !== 'undefined' && activeFilters.length > 0) { %>
    <div class="active-filter-chips mb-3">
      <% for(let chip of activeFilters) { %>
        <a href="<%= chip.href %>" class="filter-chip">
          <%= chip.label %>
          <i class="fa-solid fa-xmark"></i>
        </a>
      <% } %>
      <a href="/laundry" class="filter-chip filter-chip-clear">
        <i class="fa-solid fa-rotate-left"></i> Clear All
      </a>
    </div>
  <% } %>

  <!-- Results grid: sidebar + services -->
  <div class="row g-4">
    <!-- Desktop Filter Sidebar -->
    <div class="col-lg-3 d-none d-lg-block">
      <div class="filter-sidebar">
        <h6 class="filter-sidebar-title"><i class="fa-solid fa-sliders"></i> Filters</h6>
        <%- include("./includes/searchSidebar.ejs") %>
      </div>
    </div>

    <!-- Services Column -->
    <div class="col-lg-9">
      <% if(typeof allLaundries === 'undefined' || allLaundries.length === 0) { %>
        <!-- Professional Empty State -->
        <div class="empty-state text-center py-5">
          <div class="empty-state-illustration">
            <i class="fa-solid fa-shirt"></i>
          </div>
          <h4>No laundry services found</h4>
          <p class="text-muted">We couldn't find any laundry services matching your search and filters.<br>Try adjusting your filters or clearing them to see more options.</p>
          <a href="/laundry" class="btn btn-primary">
            <i class="fa-solid fa-rotate-left"></i> Clear Filters
          </a>
        </div>
      <% } else { %>
        <div class="row g-4">
          <% for(let laundry of allLaundries) { %>
            <div class="col-12 col-md-6 col-lg-4 reveal">
              <a href="/laundry/<%= laundry._id %>" class="laundry-link">
                <div class="card laundry-card h-100">
                  <div class="position-relative overflow-hidden">
                    <img src="<%= laundry.image.url %>" class="card-img-top" alt="<%= laundry.name %>">
                    <div class="laundry-card-badge">
                      <% if(laundry.availability === 'Available') { %>
                        <span class="badge bg-success">Available</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Closed</span>
                      <% } %>
                    </div>
                  </div>
                  <div class="card-body">
                    <h5 class="card-title"><%= laundry.name %></h5>
                    <p class="card-text mb-1">
                      <i class="fa-solid fa-location-dot" style="color: var(--primary);"></i>
                      <%= laundry.city || laundry.location || 'Location not set' %>
                    </p>
                    <div class="laundry-services mt-2">
                      <% if(laundry.pickupAvailable) { %><span class="laundry-service-tag"><i class="fa-solid fa-truck"></i> Pickup</span><% } %>
                      <% if(laundry.deliveryAvailable) { %><span class="laundry-service-tag"><i class="fa-solid fa-truck-fast"></i> Delivery</span><% } %>
                      <% if(laundry.sameDayService) { %><span class="laundry-service-tag"><i class="fa-solid fa-bolt"></i> Same Day</span><% } %>
                    </div>
                    <p class="price-text mt-2 mb-0">
                      &#8377;<%= laundry.washFoldPrice.toLocaleString("en-IN") %> <small style="font-size: 0.8rem; font-weight: 400; color: var(--text-secondary);">/ wash &amp; fold</small>
                    </p>
                  </div>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Mobile Filter Drawer (Bootstrap Offcanvas) -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="laundryFilterDrawer" aria-labelledby="laundryFilterDrawerLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="laundryFilterDrawerLabel"><i class="fa-solid fa-sliders"></i> Filter Laundry Services</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%- include("./includes/searchSidebar.ejs") %>
  </div>
</div>
