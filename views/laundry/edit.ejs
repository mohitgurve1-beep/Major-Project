<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <h3><i class="fa-solid fa-shirt"></i> Edit your Laundry Service</h3>
        <form method="POST" action="/laundry/<%= laundry._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="name" class="form-label">Service Name *</label>
                <input type="text" name="laundry[name]" id="name" value="<%= laundry.name %>" class="form-control" required>
                <div class="invalid-feedback">Please provide a service name.</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="laundry[description]" id="description" class="form-control" rows="3"><%= laundry.description || '' %></textarea>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Current Service Image</label>
                <br>
                <img src="<%= originalImageUrl %>" alt="<%= laundry.name %>" style="max-width: 100%; height: auto; border-radius: 8px;">
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload New Image</label>
                <input type="file" name="laundry[image]" id="image" class="form-control">
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="washFoldPrice" class="form-label">Wash &amp; Fold Price (&#8377;) *</label>
                    <input type="number" name="laundry[washFoldPrice]" id="washFoldPrice" value="<%= laundry.washFoldPrice %>" min="0" class="form-control" required>
                    <div class="invalid-feedback">Price should be valid.</div>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="ironPrice" class="form-label">Iron Price (&#8377;)</label>
                    <input type="number" name="laundry[ironPrice]" id="ironPrice" value="<%= laundry.ironPrice || '' %>" min="0" class="form-control">
                </div>
                <div class="mb-3 col-md-4">
                    <label for="dryCleaningPrice" class="form-label">Dry Cleaning Price (&#8377;)</label>
                    <input type="number" name="laundry[dryCleaningPrice]" id="dryCleaningPrice" value="<%= laundry.dryCleaningPrice || '' %>" min="0" class="form-control">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Convenience Options</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="laundry[pickupAvailable]" id="pickupAvailable" value="on" <%= laundry.pickupAvailable ? 'checked' : '' %>>
                    <label class="form-check-label" for="pickupAvailable"><i class="fa-solid fa-truck"></i> Pickup Available</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="laundry[deliveryAvailable]" id="deliveryAvailable" value="on" <%= laundry.deliveryAvailable ? 'checked' : '' %>>
                    <label class="form-check-label" for="deliveryAvailable"><i class="fa-solid fa-truck-fast"></i> Delivery Available</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="laundry[sameDayService]" id="sameDayService" value="on" <%= laundry.sameDayService ? 'checked' : '' %>>
                    <label class="form-check-label" for="sameDayService"><i class="fa-solid fa-bolt"></i> Same Day Service</label>
                </div>
            </div>

            <div class="mb-3">
                <label for="workingHours" class="form-label">Working Hours</label>
                <input type="text" name="laundry[workingHours]" id="workingHours" value="<%= laundry.workingHours || '' %>" class="form-control">
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="address" class="form-label">Address</label>
                    <input type="text" name="laundry[address]" id="address" value="<%= laundry.address || '' %>" class="form-control">
                </div>
                <div class="mb-3 col-md-6">
                    <label for="city" class="form-label">City</label>
                    <input type="text" name="laundry[city]" id="city" value="<%= laundry.city || '' %>" class="form-control">
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="location" class="form-label">Area / Location</label>
                    <input type="text" name="laundry[location]" id="location" value="<%= laundry.location || '' %>" class="form-control">
                </div>
                <div class="mb-3 col-md-6">
                    <label for="contactNumber" class="form-label">Contact Number</label>
                    <input type="text" name="laundry[contactNumber]" id="contactNumber" value="<%= laundry.contactNumber || '' %>" class="form-control">
                </div>
            </div>

            <div class="mb-3">
                <label for="mapLocation" class="form-label">Google Map Location</label>
                <input type="text" name="laundry[mapLocation]" id="mapLocation" value="<%= laundry.mapLocation || '' %>" class="form-control">
            </div>

            <div class="mb-3">
                <label for="availability" class="form-label">Availability</label>
                <select name="laundry[availability]" id="availability" class="form-select">
                    <option value="">Select Availability</option>
                    <% for(let o of availabilityOptions) { %>
                        <option value="<%= o %>" <%= laundry.availability === o ? 'selected' : '' %>><%= o %></option>
                    <% } %>
                </select>
            </div>

            <button class="btn btn-dark edit-btn mt-3"><i class="fa-solid fa-pen"></i> Update Service</button>
        </form>
    </div>
</div>
