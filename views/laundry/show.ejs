<% layout("/layouts/boilerplate") %>
<%
  let allImages = [];
  if(laundry.images && laundry.images.length > 0) {
    allImages = laundry.images;
  } else if(laundry.image && laundry.image.url) {
    allImages = [laundry.image];
  }
  let mainImage = allImages.length > 0 ? allImages[0] : null;
%>

<!-- ============================================ -->
<!-- LAUNDRY PAGE HEADER                          -->
<!-- ============================================ -->
<div class="show-page-header mt-4">
  <div class="row">
    <div class="col-lg-8">
      <h2><%= laundry.name %></h2>
      <p class="location-text">
        <i class="fa-solid fa-location-dot"></i>
        <%= [laundry.address, laundry.city, laundry.location].filter(Boolean).join(', ') || 'Location not set' %>
      </p>
    </div>
    <div class="col-lg-4 text-lg-end">
      <% if(laundry.availability === 'Available') { %>
        <span class="badge bg-success status-badge" style="font-size: 0.8rem; padding: 0.5em 1em; border-radius: 50px;">Available</span>
      <% } else { %>
        <span class="badge bg-secondary status-badge" style="font-size: 0.8rem; padding: 0.5em 1em; border-radius: 50px;">Closed</span>
      <% } %>
    </div>
  </div>
</div>

<!-- ============================================ -->
<!-- GALLERY + CONTACT CARD                       -->
<!-- ============================================ -->
<div class="row g-4">
  <!-- Left Column: Gallery + Details -->
  <div class="col-lg-8">
    <!-- Gallery -->
    <div class="gallery-section">
      <% if(mainImage) { %>
        <div class="gallery-main">
          <img id="laundryGalleryMain" src="<%= mainImage.url %>" alt="<%= laundry.name %>" class="w-100">
        </div>
      <% } %>
      <% if(allImages.length > 1) { %>
        <div class="gallery-thumbs">
          <% for(let i = 0; i < allImages.length && i < 5; i++) { %>
            <img src="<%= allImages[i].url %>" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" alt="View <%= i + 1 %>" onclick="document.getElementById('laundryGalleryMain').src=this.src; document.querySelectorAll('.gallery-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');">
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Laundry Info Grid -->
    <div class="laundry-info-grid">
      <div class="laundry-info-item">
        <i class="fa-solid fa-shirt"></i>
        <div class="info-label">Wash &amp; Fold</div>
        <div class="info-value">&#8377;<%= laundry.washFoldPrice.toLocaleString("en-IN") %></div>
      </div>
      <div class="laundry-info-item">
        <i class="fa-solid fa-shirt"></i>
        <div class="info-label">Iron</div>
        <div class="info-value">&#8377;<%= laundry.ironPrice ? laundry.ironPrice.toLocaleString("en-IN") : 'N/A' %></div>
      </div>
      <div class="laundry-info-item">
        <i class="fa-solid fa-dry-cleaning"></i>
        <div class="info-label">Dry Cleaning</div>
        <div class="info-value">&#8377;<%= laundry.dryCleaningPrice ? laundry.dryCleaningPrice.toLocaleString("en-IN") : 'N/A' %></div>
      </div>
      <div class="laundry-info-item">
        <i class="fa-solid fa-clock"></i>
        <div class="info-label">Working Hours</div>
        <div class="info-value"><%= laundry.workingHours || 'N/A' %></div>
      </div>
      <div class="laundry-info-item">
        <i class="fa-solid fa-city"></i>
        <div class="info-label">City</div>
        <div class="info-value"><%= laundry.city || 'N/A' %></div>
      </div>
      <div class="laundry-info-item">
        <i class="fa-solid fa-location-dot"></i>
        <div class="info-label">Area</div>
        <div class="info-value"><%= laundry.location || 'N/A' %></div>
      </div>
      <div class="laundry-info-item">
        <i class="fa-solid fa-phone"></i>
        <div class="info-label">Contact</div>
        <div class="info-value"><%= laundry.contactNumber || 'N/A' %></div>
      </div>
    </div>

    <!-- Services Provided -->
    <div class="mb-4">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-list-check"></i> Services Provided</h5>
      <div class="laundry-services-grid">
        <div class="laundry-service-provided <%= laundry.pickupAvailable ? 'active' : '' %>">
          <i class="fa-solid fa-truck"></i>
          <span>Pickup</span>
          <small><%= laundry.pickupAvailable ? 'Available' : 'Not available' %></small>
        </div>
        <div class="laundry-service-provided <%= laundry.deliveryAvailable ? 'active' : '' %>">
          <i class="fa-solid fa-truck-fast"></i>
          <span>Delivery</span>
          <small><%= laundry.deliveryAvailable ? 'Available' : 'Not available' %></small>
        </div>
        <div class="laundry-service-provided <%= laundry.sameDayService ? 'active' : '' %>">
          <i class="fa-solid fa-bolt"></i>
          <span>Same Day</span>
          <small><%= laundry.sameDayService ? 'Available' : 'Not available' %></small>
        </div>
      </div>
    </div>

    <!-- Working Hours -->
    <div class="mb-4">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-clock"></i> Working Hours</h5>
      <p class="text-secondary mb-0"><%= laundry.workingHours || 'Working hours not provided.' %></p>
    </div>

    <!-- Description -->
    <div class="mb-4">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-file-lines"></i> About this Service</h5>
      <p class="text-secondary"><%= laundry.description || 'No description provided.' %></p>
    </div>

    <!-- Address -->
    <div class="mb-4">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-location-dot"></i> Address</h5>
      <p class="text-secondary mb-0"><%= laundry.address || 'Address not provided.' %></p>
    </div>

    <!-- Owner Card -->
    <div class="owner-card mb-4">
      <div class="d-flex align-items-center gap-3">
        <div class="owner-avatar">
          <%= laundry.owner ? laundry.owner.username.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="flex-grow-1">
          <div class="owner-name"><%= laundry.owner ? laundry.owner.username : 'Unknown' %></div>
          <div class="owner-meta"><i class="fa-solid fa-house"></i> Laundry Owner</div>
        </div>
        <% if(isOwnerOfLaundry) { %>
          <a href="/laundry/<%= laundry._id %>/edit" class="btn btn-outline-primary btn-sm" style="border-radius: 50px;">
            <i class="fa-solid fa-pen"></i> Edit
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right Column: Contact Card -->
  <div class="col-lg-4">
    <div class="sticky-contact-card">
      <div class="price-display mb-3">
        &#8377;<%= laundry.washFoldPrice.toLocaleString("en-IN") %>
        <small>/ wash &amp; fold</small>
      </div>
      <hr>
      <div class="mb-3">
        <p class="mb-1"><i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> <%= laundry.city || 'N/A' %></p>
        <p class="mb-1"><i class="fa-solid fa-clock" style="color: var(--primary);"></i> <%= laundry.workingHours || 'N/A' %></p>
        <p class="mb-1"><i class="fa-solid fa-shirt" style="color: var(--primary);"></i> Iron: &#8377;<%= laundry.ironPrice ? laundry.ironPrice.toLocaleString("en-IN") : 'N/A' %></p>
        <p class="mb-1"><i class="fa-solid fa-dry-cleaning" style="color: var(--primary);"></i> Dry Clean: &#8377;<%= laundry.dryCleaningPrice ? laundry.dryCleaningPrice.toLocaleString("en-IN") : 'N/A' %></p>
      </div>
      <hr>
      <div class="d-flex align-items-center gap-2 mb-3">
        <div class="profile-avatar" style="width: 44px; height: 44px; font-size: 1.1rem;">
          <%= laundry.owner ? laundry.owner.username.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div>
          <strong><%= laundry.owner ? laundry.owner.username : 'Unknown' %></strong><br>
          <small class="text-muted">Laundry Owner</small>
        </div>
      </div>
      <% if(isOwnerOfLaundry) { %>
        <a href="/laundry/<%= laundry._id %>/edit" class="btn btn-book mb-2"><i class="fa-solid fa-pen"></i> Edit Service</a>
      <% } else { %>
        <a href="tel:<%= laundry.contactNumber || '' %>" class="btn btn-book mb-2"><i class="fa-solid fa-phone"></i> Contact for Service</a>
      <% } %>
      <hr>
      <div class="text-center text-muted" style="font-size: 0.8rem;">
        <i class="fa-solid fa-shield-check"></i> Contact directly for pricing &amp; pickup
      </div>
    </div>
  </div>
</div>
