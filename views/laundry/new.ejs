<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <h3><i class="fa-solid fa-shirt"></i> Create a new Laundry Service</h3>
        <p class="text-muted">Provide details about your laundry service so students can find and contact you.</p>
        <form action="/laundry" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="name" class="form-label">Service Name *</label>
                <input type="text" name="laundry[name]" id="name" placeholder="e.g. Sparkle Wash & Fold" class="form-control" required>
                <div class="invalid-feedback">Please provide a service name.</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="laundry[description]" id="description" class="form-control" rows="3" placeholder="Short description of your laundry service and specialities"></textarea>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload service image</label>
                <input type="file" name="laundry[image]" id="image" class="form-control" required>
                <div class="invalid-feedback">Please upload a service image.</div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="washFoldPrice" class="form-label">Wash &amp; Fold Price (&#8377;) *</label>
                    <input type="number" name="laundry[washFoldPrice]" id="washFoldPrice" placeholder="e.g. 100" min="0" class="form-control" required>
                    <div class="invalid-feedback">Price should be valid.</div>
                </div>
                <div class="mb-3 col-md-4">
                    <label for="ironPrice" class="form-label">Iron Price (&#8377;)</label>
                    <input type="number" name="laundry[ironPrice]" id="ironPrice" placeholder="e.g. 50" min="0" class="form-control">
                </div>
                <div class="mb-3 col-md-4">
                    <label for="dryCleaningPrice" class="form-label">Dry Cleaning Price (&#8377;)</label>
                    <input type="number" name="laundry[dryCleaningPrice]" id="dryCleaningPrice" placeholder="e.g. 200" min="0" class="form-control">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label d-block">Convenience Options</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="laundry[pickupAvailable]" id="pickupAvailable" value="on">
                    <label class="form-check-label" for="pickupAvailable"><i class="fa-solid fa-truck"></i> Pickup Available</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="laundry[deliveryAvailable]" id="deliveryAvailable" value="on">
                    <label class="form-check-label" for="deliveryAvailable"><i class="fa-solid fa-truck-fast"></i> Delivery Available</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="laundry[sameDayService]" id="sameDayService" value="on">
                    <label class="form-check-label" for="sameDayService"><i class="fa-solid fa-bolt"></i> Same Day Service</label>
                </div>
            </div>

            <div class="mb-3">
                <label for="workingHours" class="form-label">Working Hours</label>
                <input type="text" name="laundry[workingHours]" id="workingHours" placeholder="e.g. Mon-Sat 9 AM - 7 PM" class="form-control">
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="address" class="form-label">Address</label>
                    <input type="text" name="laundry[address]" id="address" placeholder="Street, building, landmark" class="form-control">
                </div>
                <div class="mb-3 col-md-6">
                    <label for="city" class="form-label">City</label>
                    <input type="text" name="laundry[city]" id="city" placeholder="e.g. Nagpur" class="form-control">
                </div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="location" class="form-label">Area / Location</label>
                    <input type="text" name="laundry[location]" id="location" placeholder="e.g. Trimurti Nagar" class="form-control">
                </div>
                <div class="mb-3 col-md-6">
                    <label for="contactNumber" class="form-label">Contact Number</label>
                    <input type="text" name="laundry[contactNumber]" id="contactNumber" placeholder="+91 98765 43210" class="form-control">
                </div>
            </div>

            <div class="mb-3">
                <label for="mapLocation" class="form-label">Google Map Location</label>
                <input type="text" name="laundry[mapLocation]" id="mapLocation" placeholder="Google Maps link or coordinates" class="form-control">
            </div>

            <div class="mb-3">
                <label for="availability" class="form-label">Availability</label>
                <select name="laundry[availability]" id="availability" class="form-select">
                    <option value="">Select Availability</option>
                    <% for(let o of availabilityOptions) { %>
                        <option value="<%= o %>"><%= o %></option>
                    <% } %>
                </select>
            </div>

            <button class="btn btn-dark add-btn mt-3"><i class="fa-solid fa-plus"></i> Add Service</button>
            <a href="/laundry" class="btn btn-outline-secondary mt-3">Cancel</a>
        </form>
    </div>
</div>
