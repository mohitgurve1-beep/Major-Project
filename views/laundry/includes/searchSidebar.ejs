<!-- ============================================ -->
<!-- LAUNDRY SEARCH & FILTER SIDEBAR              -->
<!-- ============================================ -->
<%
  const f = typeof filters !== 'undefined' ? filters : {};
  const ao = typeof availabilityOptions !== 'undefined' ? availabilityOptions : ['Available', 'Closed'];
%>

<form action="/laundry" method="GET" class="filter-form">
  <!-- Search by name / description / city / area -->
  <div class="filter-group">
    <label class="filter-label" for="laundryQ">Search</label>
    <div class="input-group input-group-sm">
      <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
      <input type="text" class="form-control" id="laundryQ" name="q" placeholder="Name, city, area..." value="<%= f.q || '' %>">
    </div>
  </div>

  <!-- City -->
  <div class="filter-group">
    <label class="filter-label" for="laundryCity">City</label>
    <input type="text" class="form-control form-control-sm" id="laundryCity" name="city" placeholder="e.g. Nagpur" value="<%= f.city || '' %>">
  </div>

  <!-- Location / Area -->
  <div class="filter-group">
    <label class="filter-label" for="laundryLocation">Area / Location</label>
    <input type="text" class="form-control form-control-sm" id="laundryLocation" name="location" placeholder="e.g. Trimurti Nagar" value="<%= f.location || '' %>">
  </div>

  <!-- Price (Min/Max) -->
  <div class="filter-group">
    <label class="filter-label">Wash &amp; Fold Price (&#8377;)</label>
    <div class="row g-2">
      <div class="col-6">
        <input type="number" class="form-control form-control-sm" name="minPrice" placeholder="Min" min="0" value="<%= f.minPrice || '' %>">
      </div>
      <div class="col-6">
        <input type="number" class="form-control form-control-sm" name="maxPrice" placeholder="Max" min="0" value="<%= f.maxPrice || '' %>">
      </div>
    </div>
  </div>

  <!-- Convenience Options -->
  <div class="filter-group">
    <label class="filter-label">Convenience</label>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="pickup" id="pickupFilter" value="on" <%= f.pickup === 'on' ? 'checked' : '' %>>
      <label class="form-check-label" for="pickupFilter"><i class="fa-solid fa-truck"></i> Pickup Available</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="delivery" id="deliveryFilter" value="on" <%= f.delivery === 'on' ? 'checked' : '' %>>
      <label class="form-check-label" for="deliveryFilter"><i class="fa-solid fa-truck-fast"></i> Delivery Available</label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" name="sameDay" id="sameDayFilter" value="on" <%= f.sameDay === 'on' ? 'checked' : '' %>>
      <label class="form-check-label" for="sameDayFilter"><i class="fa-solid fa-bolt"></i> Same Day Service</label>
    </div>
  </div>

  <!-- Availability -->
  <div class="filter-group">
    <label class="filter-label">Availability</label>
    <select name="availability" class="form-select form-select-sm">
      <option value="">Any Availability</option>
      <% for(let o of ao) { %>
        <option value="<%= o %>" <%= f.availability === o ? 'selected' : '' %>><%= o %></option>
      <% } %>
    </select>
  </div>

  <!-- Actions -->
  <div class="d-grid gap-2 mt-4">
    <button type="submit" class="btn btn-primary btn-sm">
      <i class="fa-solid fa-magnifying-glass"></i> Apply Filters
    </button>
    <a href="/laundry" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-rotate-left"></i> Clear Filters
    </a>
  </div>
</form>
